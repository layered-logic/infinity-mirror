# Layered Logic Infinity Mirror — project-wide sdkconfig defaults.
#
# Applied as the baseline before any board- or variant-specific
# overrides. Keep this file minimal — only settings the project
# requires across every build target belong here.

# --- Flash + partition layout -----------------------------------------
# 4MB flash with the custom ab_with_factory partition table at
# Firmware/v1/partitions.csv. See that file for the slot map.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- HTTP server: WebSocket support -----------------------------------
# Required by core/transport/. Without this flag esp_http_server
# accepts the URI registration but the WS upgrade handshake fails.
CONFIG_HTTPD_WS_SUPPORT=y

# --- OTA: allow plain HTTP for the dev-test path ----------------------
# esp_https_ota rejects http:// URLs with ESP_ERR_INVALID_ARG unless
# this is set. Production OTA per firmware-architecture-scoping §5.4
# uses HTTPS exclusively (ota.layeredlogic.cc behind Cloudflare); flip
# this back off when the production OTA path lands.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# --- OTA rollback safety net (NOT eFuse — pure firmware-managed) ------
# When set, the bootloader watches for OTA images marked PENDING_VERIFY
# and rolls back to the previously-good slot if the new image resets
# before calling esp_ota_mark_app_valid_cancel_rollback(). core/ota
# wires the mark on first LL_EV_WIFI_CONNECTED — so any OTA that
# panics during boot, or never reaches the network, is automatically
# rolled back on the next reset. Cheap insurance for dev OTAs;
# orthogonal to the eFuse-based anti-rollback below (which is for
# downgrade-attack defense, not boot-loop recovery).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Production hardening (deliberately left disabled this sprint) ----
# All three of these are eFuse burns and irreversible. Per
# docs/mini-sprint-app-demo.md §1a, they stay off until production.
# CONFIG_SECURE_BOOT_V2_ENABLED        — leave unset
# CONFIG_FLASH_ENCRYPTION_ENABLED      — leave unset
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK  — leave unset
