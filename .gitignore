# Sensitive business documents — never commit
business/

# Claude Code local config (per-machine settings, launch configs, etc.).
# Using .claude/* (not .claude/) so we can still descend into the dir
# and re-include .claude/skills/ — see git's "ignored directory ⇒ files
# inside cannot be re-included" gotcha.
.claude/*
# … but DO track skills — they're project methodology, not per-machine.
!.claude/skills/

# Obsidian local editor config (per-machine)
.obsidian/

# VS Code local editor config (per-machine)
.vscode/

# 3D-model exports from the housing design scripts — bulky binary CAD
# output, regenerable from the source models. Not worth versioning.
*.stl

# Obsidian "new file" stubs
Untitled.*

# Python cache
__pycache__/
*.pyc

# Build/flash/boot logs from firmware bring-up. Narrated in sprint_log.md;
# raw logs not worth versioning.
/*.log
Firmware/v1/*.log

# CEFbox reference DXFs — paid third-party content, used as ground truth
# for the LL-051 dieline generator. Geometry inferred from these gets
# committed; the source files do not.
Assembly_docs/Packaging_Templates/
